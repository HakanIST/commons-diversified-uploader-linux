<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>commons-diversified-uploader</AssemblyName>
    <RootNamespace>Uploader</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GirCore.Adw-1" Version="0.*" />
    <PackageReference Include="GirCore.Gtk-4.0" Version="0.*" />
    <Content Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\core\src\UploaderCore\UploaderCore.csproj" />
  </ItemGroup>
</Project>
